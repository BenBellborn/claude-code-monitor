{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/ccm.py\" --hook > /dev/null 2>&1 || python \"${CLAUDE_PLUGIN_ROOT}/ccm.py\" --hook > /dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/ccm.py\" --hook > /dev/null 2>&1 || python \"${CLAUDE_PLUGIN_ROOT}/ccm.py\" --hook > /dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
